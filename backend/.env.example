# Copy this to .env and fill values
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: force a specific model if auto-detection does not find one.
# Example: gemini-3.5-flash
GEMINI_MODEL=

# Comma-separated origins allowed to call the Flask API
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# true for local debugging, false for normal run
FLASK_DEBUG=true

# Optional Flask bind settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional local inference. Run `ollama serve` and `ollama pull qwen3.5:4b` first.
# Public production still needs a reachable inference server; loopback is local only.
AI_PROVIDER=gemini
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=75
