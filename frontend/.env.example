# ResumeX Frontend Environment Variables

# The base URL of the ResumeX backend API. 
# For local development, this is typically http://127.0.0.1:5000
# For production, this should be the URL of your hosted backend (e.g., https://resume-ai-backend.up.railway.app)
VITE_API_BASE_URL=http://127.0.0.1:5000
